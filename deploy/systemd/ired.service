[Unit]
Description=IRE full node
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ired
Group=ired
WorkingDirectory=/var/lib/ired
ExecStart=/usr/local/bin/ired start --home /var/lib/ired
Restart=always
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/ired

[Install]
WantedBy=multi-user.target
