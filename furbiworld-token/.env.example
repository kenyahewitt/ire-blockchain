# Copy to .env, fill in, then: source .env

# --- token ---
TOKEN_NAME="FurbiWorld"
TOKEN_SYMBOL="FURBI"
TOKEN_SUPPLY=1000000000          # whole tokens (1 billion)
CREATOR_BPS=0                    # 0 = 100% into the pool (fair launch). Max 1000 = 10% to you.

# --- chain ---
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# Uniswap V2 Router02 on Robinhood Chain. Confirm with ./check-router.sh before launching.
ROUTER=0x89e5db8b5aa49aa85ac63f691524311aeb649eba

# --- budget: $100 total ---
# ~0.038 ETH (~$95) into the pool; the rest of $100 covers gas (well under $1 on this chain).
LAUNCH_ETH_WEI=48000000000000000
